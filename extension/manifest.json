{
  "manifest_version": 3,
  "name": "portal-auto-login",
  "version": "0.4.4",
  "minimum_chrome_version": "120",
  "description": "每次启动 Chrome 时自动完成一次陕西师范大学校园网移动认证。",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://202.117.144.205/*",
    "http://www.msftconnecttest.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "portal-auto-login",
    "default_icon": {
      "16": "icons/emblem-16.png",
      "32": "icons/emblem-32.png",
      "48": "icons/emblem-48.png",
      "128": "icons/emblem-128.png"
    }
  },
  "icons": {
    "16": "icons/emblem-16.png",
    "32": "icons/emblem-32.png",
    "48": "icons/emblem-48.png",
    "128": "icons/emblem-128.png"
  }
}
